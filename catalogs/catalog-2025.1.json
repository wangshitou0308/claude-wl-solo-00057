  "fault_rules": [
    {
      "rule_id": "R-F001-REPAIR",
      "fault_code": "F001",
      "priority": 20,
      "conclusion": "repairable",
      "required_measurements": ["smart_log"],
      "conditions": [
        {"measurement": "smart_log", "op": "eq", "value": "complete"}
      ],
      "message": "SMART 诊断完整，存储故障允许按替代链维修"
    },
    {
      "rule_id": "R-F001-NEEDDATA",
      "fault_code": "F001",
      "priority": 20,
      "conclusion": "need_data",
      "required_measurements": ["smart_log"],
      "conditions": [
        {"measurement": "smart_log", "op": "eq", "value": "pending"}
      ],
      "message": "SMART 自检尚未完成，需补充数据后再判定"
    },
    {
      "rule_id": "R-F002-REPAIR",
      "fault_code": "F002",
      "priority": 20,
      "conclusion": "repairable",
      "required_measurements": ["vibration_mm_s"],
      "conditions": [
        {"measurement": "vibration_mm_s", "op": "gt", "value": 2}
      ],
      "message": "振动超标，判定可维修（减震更换）"
    },
    {
      "rule_id": "R-F002-FORBID",
      "fault_code": "F002",
      "priority": 20,
      "conclusion": "forbidden",
      "required_measurements": ["vibration_mm_s"],
      "conditions": [
        {"measurement": "vibration_mm_s", "op": "gt", "value": 2}
      ],
      "message": "同优先级冲突规则：振动超标禁止维修（结构疲劳）"
    },
    {
      "rule_id": "R-F003-FORBID",
      "fault_code": "F003",
      "priority": 30,
      "conclusion": "forbidden",
      "required_measurements": ["temperature_c"],
      "conditions": [
        {"measurement": "temperature_c", "op": "gt", "value": 85}
      ],
      "message": "温度超过 85C，禁止维修（热失控风险）"
    }
  ]
}
