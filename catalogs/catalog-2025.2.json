      "rule_id": "R-F002-REPAIR",
      "fault_code": "F002",
      "priority": 20,
      "conclusion": "repairable",
      "required_measurements": [
        "vibration_mm_s"
      ],
      "conditions": [
        {
          "measurement": "vibration_mm_s",
          "op": "gt",
          "value": 2
        }
      ],
      "message": "振动超标，判定可维修（减震更换）"
    },
    {
      "rule_id": "R-F002-FORBID",
      "fault_code": "F002",
      "priority": 20,
      "conclusion": "forbidden",
      "required_measurements": [
        "vibration_mm_s"
      ],
      "conditions": [
        {
          "measurement": "vibration_mm_s",
          "op": "gt",
          "value": 2
        }
      ],
      "message": "同优先级冲突规则：振动超标禁止维修（结构疲劳）"
    },
    {
      "rule_id": "R-F003-FORBID",
      "fault_code": "F003",
      "priority": 30,
      "conclusion": "forbidden",
      "required_measurements": [
